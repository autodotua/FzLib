<Styles
xmlns="https://github.com/avaloniaui"
xmlns:cvt="using:FzLib.Avalonia.Converters"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Style Selector="HeaderedContentControl.GroupBox">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <ContentControl
                    Background="{TemplateBinding HeaderTemplate}"
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                    TextElement.FontWeight="Bold" />
                    <!--<TextBlock
                    FontWeight="Bold"
                    Text="{TemplateBinding Header}" />-->
                    <ContentPresenter
                    Name="PART_ContentPresenter"
                    Grid.Row="2"
                    Padding="8"
                    Content="{TemplateBinding Content}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="HeaderedContentControl.GroupBoxWithBorder">
        <Setter Property="Background" Value="{DynamicResource Background0}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,*">

                    <!--  Header  -->
                    <Border
                    Margin="5,0,0,0" x:Name="PART_Header"
                    Padding="5,0,5,0"
                    Background="Transparent"
                    ZIndex="1">
                        <TextBlock
                        FontWeight="Bold"
                        Text="{TemplateBinding Header}" />
                    </Border>

                    <!--  Content Area  -->
                    <Border
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,0"
                    Padding="0,5,0,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                        <ContentPresenter
                        Name="PART_ContentPresenter"
                        Padding="8"
                        Content="{TemplateBinding Content}" />


                        <Border.OpacityMask>
                        <MultiBinding Converter="{x:Static cvt:InternalConverters.BorderGapMask}"
                                      ConverterParameter="6">
                            <Binding ElementName="PART_Header"
                                     Path="Bounds.Width"/>
                            <Binding ElementName="PART_Header"
                                     Path="Bounds.Height"/>
                            <Binding RelativeSource="{RelativeSource Self}"
                                     Path="Bounds.Width"/>
                            <Binding RelativeSource="{RelativeSource Self}"
                                     Path="Bounds.Height"/>
                        </MultiBinding>
                        </Border.OpacityMask>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>