<Styles
x:Class="FzLib.Avalonia.Styles.FzLibAvaloniaStyles"
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Brushes.axaml" />
                <ResourceInclude Source="/Styles/FormItemThemes.axaml" />
                <ResourceInclude Source="/Styles/ExtendedWindowThemes.axaml" />
                <ResourceInclude Source="/Styles/DialogHostThemes.axaml" />
                <ResourceInclude Source="/Styles/PresetDialogThemes.axaml" />
                <ResourceInclude Source="/Styles/PogressRingThemes.axaml" />
                <ResourceInclude Source="/Styles/PogressRingBoxOverlayThemes.axaml" />
                <ResourceInclude Source="/Styles/PogressRingOverlayThemes.axaml" />
                <ResourceInclude Source="/Styles/RadioButtonGroupThemes.axaml" />
                <ResourceInclude Source="/Styles/StringListEditorThemes.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="/Styles/ButtonStyles.axaml" />
    <StyleInclude Source="/Styles/SliderStyles.axaml" />
    <StyleInclude Source="/Styles/TextStyles.axaml" />
    <StyleInclude Source="/Styles/GroupBoxStyles.axaml" />
    <StyleInclude Source="/Styles/NumericUpDownStyles.axaml" />
</Styles>