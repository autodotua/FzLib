<Styles
    x:Class="FzLib.Avalonia.Styles.FzLibAvaloniaStyles"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/FormItemStyle.axaml" />
                <ResourceInclude Source="/Styles/ExtendedWindowStyle.axaml" />
                <ResourceInclude Source="/Styles/DialogHostStyles.axaml" />
                <ResourceInclude Source="/Styles/PresetDialogStyles.axaml" />
                <ResourceInclude Source="/Styles/PogressRingStyle.axaml" />
                <ResourceInclude Source="/Styles/PogressRingBoxOverlayStyle.axaml" />
                <ResourceInclude Source="/Styles/PogressRingOverlayStyle.axaml" />
                <ResourceInclude Source="/Styles/Brushes.axaml" />
                <ResourceInclude Source="/Styles/RadioButtonGroupStyles.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    <StyleInclude Source="/Styles/ButtonStyles.axaml" />
    <StyleInclude Source="/Styles/GroupBoxStyles.axaml" />
</Styles>