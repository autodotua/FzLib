<ResourceDictionary
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:b="clr-namespace:FzLib.Avalonia.Behaviors"
xmlns:c="using:FzLib.Avalonia.Controls"
xmlns:sys="using:System">

	<Design.PreviewWith>
		<c:ExtendedWindow Width="200" Height="200"/>
	</Design.PreviewWith>

	<x:Double x:Key="CaptionButtonWidth">48</x:Double>
	<x:Double x:Key="ExtendedWindowTitleBarHeight">30</x:Double>
	<x:Double x:Key="ExtendedWindowShadowWidth">4</x:Double>
	<Thickness x:Key="ExtendedWindowShadowMargin">4</Thickness>
	<Thickness x:Key="ExtendedWindowBorderThickness">1</Thickness>
	<SolidColorBrush
	x:Key="ExtendedWindowBorderBrush"
	Opacity="0.3"
	Color="Gray" />
	<!--<BoxShadows x:Key="ExtendedWindowBoxShadow">0 0 4 0 #88000000</BoxShadows>-->
	<CornerRadius x:Key="ExtendedWindowCornerRadius">4</CornerRadius>

	<ControlTheme
	x:Key="FluentDrawnCaptionButton"
	TargetType="Button">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource Foreground0}" />
		<Setter Property="Width" Value="{DynamicResource CaptionButtonWidth}" />
		<Setter Property="Height" Value="{DynamicResource ExtendedWindowTitleBarHeight}" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="(WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
		<Setter Property="Template">
			<ControlTemplate>
				<ContentPresenter
				Name="PART_ContentPresenter"
				Padding="{TemplateBinding Padding}"
				HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
				VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
				Background="{TemplateBinding Background}"
				BorderBrush="{TemplateBinding BorderBrush}"
				BorderThickness="{TemplateBinding BorderThickness}"
				Content="{TemplateBinding Content}"
				Foreground="{TemplateBinding Foreground}" />
			</ControlTemplate>
		</Setter>

		<Style Selector="^:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Background2}" />
		</Style>

		<Style Selector="^:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource Background1}" />
		</Style>
	</ControlTheme>


	<ControlTheme
	x:Key="{x:Type c:WindowButtons}"
	TargetType="c:WindowButtons">
		<Setter Property="Template">
			<ControlTemplate>
				<StackPanel Orientation="Horizontal">
					<Button
					x:Name="PART_MinimizeButton"
					Theme="{StaticResource FluentDrawnCaptionButton}">
						<Line
						Width="{StaticResource CaptionButtonWidth}"
						Height="{StaticResource ExtendedWindowTitleBarHeight}"
						Stroke="{DynamicResource Foreground0}"
						StartPoint="18,15"
						EndPoint="30,15" />
					</Button>
					<Button
					x:Name="PART_ResizeButton"
					Theme="{StaticResource FluentDrawnCaptionButton}">
						<Panel>
							<Rectangle
							Width="10"
							Height="10"  IsVisible="{TemplateBinding IsWindowNormal}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							StrokeThickness="1"
							Stroke="{DynamicResource Foreground0}"/>
							<Path  IsVisible="{TemplateBinding IsWindowMaximized}"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch" 
							StrokeThickness="1"
							Data="M20 13 L20 11 L28 11 L28 19 L26 19 L26 13 L18 13 L18 21 L26 21 L26 19"
							Width="{StaticResource CaptionButtonWidth}"
							Height="{StaticResource ExtendedWindowTitleBarHeight}"
							Stroke="{DynamicResource Foreground0}">
								<Path.RenderTransform>
									<TranslateTransform X="2" Y="-2" />
								</Path.RenderTransform>
							</Path>
						</Panel>
					</Button>
					<Button
					x:Name="PART_CloseButton"
					CornerRadius="{TemplateBinding RightTopCornerRadius}"
					Theme="{StaticResource FluentDrawnCaptionButton}">
						<Button.Styles>
							<Style Selector="Button:pointerover /template/ ContentPresenter">
								<Setter Property="Background" Value="#e81123" />
							</Style>
							<Style Selector="Button:pressed /template/ ContentPresenter">
								<Setter Property="Background" Value="#f1707a" />
							</Style>
							<Style Selector="Button  Line">
								<Setter Property="Stroke" Value="{DynamicResource Foreground0}" />
							</Style>
							<Style Selector="Button:pointerover Line">
								<Setter Property="Stroke" Value="White" />
							</Style>
							<Style Selector="Button:pressed Line">
								<Setter Property="Stroke" Value="White" />
							</Style>
						</Button.Styles>
						<Panel>
							<Line
							Width="{StaticResource CaptionButtonWidth}"
							Height="{StaticResource ExtendedWindowTitleBarHeight}"
							StartPoint="19,10"
							EndPoint="29,20" />
							<Line
							Width="{StaticResource CaptionButtonWidth}"
							Height="{StaticResource ExtendedWindowTitleBarHeight}"
							StartPoint="19,20"
							EndPoint="29,10" />
						</Panel>
					</Button>
				</StackPanel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

	<ControlTheme
	x:Key="ExtendedWindowDrawnDecorationsTheme"
	TargetType="WindowDrawnDecorations">
		<Setter Property="DefaultTitleBarHeight" Value="{StaticResource ExtendedWindowTitleBarHeight}" />
		<Setter Property="DefaultFrameThickness" Value="{StaticResource ExtendedWindowShadowMargin}" />
		<Setter Property="DefaultShadowThickness" Value="{StaticResource ExtendedWindowShadowMargin}" />
		<Setter Property="Template">
			<WindowDrawnDecorationsTemplate>
				<WindowDrawnDecorationsContent>
					<WindowDrawnDecorationsContent.Underlay>
						<Panel x:Name="PART_UnderlayWrapper">
							<Panel
							x:Name="PART_TitleBar"
							Height="{TemplateBinding TitleBarHeight}"
							VerticalAlignment="Top"
							Background="Transparent"
							IsVisible="{TemplateBinding HasTitleBar}"
							WindowDecorationProperties.ElementRole="TitleBar" />
						</Panel>
					</WindowDrawnDecorationsContent.Underlay>
				</WindowDrawnDecorationsContent>
			</WindowDrawnDecorationsTemplate>
		</Setter>

	</ControlTheme>


	<ControlTheme
	x:Key="{x:Type c:ExtendedWindow}"
	TargetType="c:ExtendedWindow">
		<Setter Property="Background" Value="{DynamicResource SystemRegionBrush}" />
		<Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
		<Setter Property="TopLevel.SystemBarColor" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
		<Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
		<Setter Property="FontFamily" Value="{DynamicResource ContentControlThemeFontFamily}" />
		<Setter Property="BorderBrush" Value="{DynamicResource ExtendedWindowBorderBrush}" />
		<Setter Property="BorderThickness" Value="{DynamicResource ExtendedWindowBorderThickness}" />
		<Setter Property="WindowDecorationsTheme" Value="{StaticResource ExtendedWindowDrawnDecorationsTheme}" />
		<Setter Property="WindowDecorations" Value="Full" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="ExtendClientAreaToDecorationsHint" Value="True" />
		<Setter Property="ExtendClientAreaTitleBarHeightHint" Value="-1" />

		<Setter Property="Template">
			<ControlTemplate TargetType="c:ExtendedWindow">
				<Panel>
					<Border
					Name="PART_TransparencyFallback"
					IsHitTestVisible="False" />
					<Border
					Margin="{TemplateBinding ShadowThickness}"
					Background="{TemplateBinding Background}"
					BoxShadow="{TemplateBinding Shadow}"
					CornerRadius="{TemplateBinding CornerRadius}"
					IsHitTestVisible="False" />
					<Panel Margin="{TemplateBinding WindowDecorationMargin}" />
					<Border
					Margin="{TemplateBinding ShadowThickness}"
					ClipToBounds="True"
					CornerRadius="{TemplateBinding CornerRadius}">
						<DockPanel>
							<Grid
							Height="30"
							ColumnDefinitions="Auto,0,Auto,8,*,2,Auto"
							DockPanel.Dock="Top">
								<Image
								Height="18"
								Margin="8,0,-4,0"
								VerticalAlignment="Center"
								IsHitTestVisible="False"
								Source="{TemplateBinding Icon}"
								Stretch="Fill" />
								<TextBlock
								Grid.Column="2"
								Margin="8,0"
								VerticalAlignment="Center"
								FontSize="12"
								IsHitTestVisible="False"
								Text="{TemplateBinding Title}" />
								<ContentControl
								Grid.Column="4"
								Margin="4,0"
								HorizontalAlignment="Right"
								Content="{TemplateBinding TitleBarFooter}" />
								<c:WindowButtons
								Grid.Column="6"
								CornerRadiusWidth="{TemplateBinding ShadowWidth}" />
							</Grid>

							<VisualLayerManager Name="PART_VisualLayerManager">
								<ContentPresenter
								Name="PART_ContentPresenter"
								Margin="{TemplateBinding Padding}"
								HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}" />
							</VisualLayerManager>
						</DockPanel>
					</Border>
				</Panel>
			</ControlTemplate>
		</Setter>
	</ControlTheme>

</ResourceDictionary>