<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <StackPanel Orientation="Vertical">

            <TextBlock
                Background="{DynamicResource Background0}"
                Foreground="{DynamicResource Foreground0}"
                Text="Background0" />

            <TextBlock
                Background="{DynamicResource Background1}"
                Foreground="{DynamicResource Foreground0}"
                Text="Background1" />

            <TextBlock
                Background="{DynamicResource Background2}"
                Foreground="{DynamicResource Foreground0}"
                Text="Background2" />
            <TextBlock
                Background="{DynamicResource Background3}"
                Foreground="{DynamicResource Foreground0}"
                Text="Background3" />
            <TextBlock
                Background="{DynamicResource Foreground0}"
                Foreground="{DynamicResource Background0}"
                Text="Foreground0" />
            <TextBlock
                Background="{DynamicResource Foreground1}"
                Foreground="{DynamicResource Background0}"
                Text="Foreground1" />
            <TextBlock
                Background="{DynamicResource Foreground2}"
                Foreground="{DynamicResource Background0}"
                Text="Foreground2" />
            <TextBlock
                Background="{DynamicResource Foreground3}"
                Foreground="{DynamicResource Background0}"
                Text="Foreground3" />

            <TextBlock
                Background="{DynamicResource Accent0}"
                Foreground="{DynamicResource Background0}"
                Text="Accent0" />
            <TextBlock
                Background="{DynamicResource AccentF1}"
                Foreground="{DynamicResource Background0}"
                Text="AccentF1" />
            <TextBlock
                Background="{DynamicResource AccentF2}"
                Foreground="{DynamicResource Background0}"
                Text="AccentF2" />
            <TextBlock
                Background="{DynamicResource AccentF3}"
                Foreground="{DynamicResource Background0}"
                Text="AccentF3" />
            <TextBlock
                Background="{DynamicResource AccentB1}"
                Foreground="{DynamicResource Foreground0}"
                Text="AccentB1" />
            <TextBlock
                Background="{DynamicResource AccentB2}"
                Foreground="{DynamicResource Foreground0}"
                Text="AccentB2" />
            <TextBlock
                Background="{DynamicResource AccentB3}"
                Foreground="{DynamicResource Foreground0}"
                Text="AccentB3" />

        </StackPanel>
    </Design.PreviewWith>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush
                x:Key="AccentB3"
                Color="{DynamicResource SystemAccentColorDark1}" />
            <SolidColorBrush
                x:Key="AccentB2"
                Color="{DynamicResource SystemAccentColorDark2}" />
            <SolidColorBrush
                x:Key="AccentB1"
                Color="{DynamicResource SystemAccentColorDark3}" />

            <SolidColorBrush
                x:Key="AccentF3"
                Color="{DynamicResource SystemAccentColorLight1}" />
            <SolidColorBrush
                x:Key="AccentF2"
                Color="{DynamicResource SystemAccentColorLight2}" />
            <SolidColorBrush
                x:Key="AccentF1"
                Color="{DynamicResource SystemAccentColorLight3}" />


            <SolidColorBrush
                x:Key="Background0"
                Color="#000" />
            <SolidColorBrush
                x:Key="Background1"
                Color="#111" />
            <SolidColorBrush
                x:Key="Background2"
                Color="#222" />
            <SolidColorBrush
                x:Key="Background3"
                Color="#333" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush
                x:Key="AccentF3"
                Color="{DynamicResource SystemAccentColor}" />
            <SolidColorBrush
                x:Key="AccentF2"
                Color="{DynamicResource SystemAccentColorDark1}" />
            <SolidColorBrush
                x:Key="AccentF1"
                Color="{DynamicResource SystemAccentColorDark2}" />

            <SolidColorBrush
                x:Key="AccentB3"
                Color="{DynamicResource SystemAccentColorLight1}" />
            <SolidColorBrush
                x:Key="AccentB2"
                Color="{DynamicResource SystemAccentColorLight2}" />
            <SolidColorBrush
                x:Key="AccentB1"
                Color="{DynamicResource SystemAccentColorLight3}" />

            <SolidColorBrush
                x:Key="Background0"
                Color="#FFF" />
            <SolidColorBrush
                x:Key="Background1"
                Color="#EEE" />
            <SolidColorBrush
                x:Key="Background2"
                Color="#DDD" />
            <SolidColorBrush
                x:Key="Background3"
                Color="#CCC" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>


    <SolidColorBrush
        x:Key="Foreground0"
        Opacity="1"
        Color="{DynamicResource SystemBaseHighColor}" />
    <SolidColorBrush
        x:Key="Foreground1"
        Opacity=".9"
        Color="{DynamicResource SystemBaseHighColor}" />
    <SolidColorBrush
        x:Key="Foreground2"
        Opacity=".8"
        Color="{DynamicResource SystemBaseHighColor}" />
    <SolidColorBrush
        x:Key="Foreground3"
        Opacity=".7"
        Color="{DynamicResource SystemBaseHighColor}" />


    <!--  为了保证兼容性，保留下面4个  -->
    <SolidColorBrush
        x:Key="Accent0"
        Color="{DynamicResource SystemAccentColor}" />
    <SolidColorBrush
        x:Key="Accent1"
        Color="{DynamicResource SystemAccentColorDark1}" />
    <SolidColorBrush
        x:Key="Accent2"
        Color="{DynamicResource SystemAccentColorDark2}" />
    <SolidColorBrush
        x:Key="Accent3"
        Color="{DynamicResource SystemAccentColorDark3}" />


</ResourceDictionary>
