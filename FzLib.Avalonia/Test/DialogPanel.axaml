<UserControl
    x:Class="FzLib.Avalonia.Test.DialogPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <WrapPanel>
        <ToggleSwitch
            IsChecked="{Binding ShowWindowDialog}"
            OffContent="显示弹出（Popup）对话框"
            OnContent="显示窗口（Window）对话框" />
        <Button
            Click="DialogButton_Click"
            Content="信息"
            Tag="1" />
        <Button
            Click="DialogButton_Click"
            Content="信息（带详情）"
            Tag="2" />
        <Button
            Click="DialogButton_Click"
            Content="警告"
            Tag="3" />
        <Button
            Click="DialogButton_Click"
            Content="错误"
            Tag="4" />
        <Button
            Click="DialogButton_Click"
            Content="异常"
            Tag="5" />
        <Button
            Click="DialogButton_Click"
            Content="是否"
            Tag="6" />
        <Button
            Click="DialogButton_Click"
            Content="是否和取消"
            Tag="7" />
        <Button
            Click="DialogButton_Click"
            Content="简单输入"
            Tag="8" />
        <Button
            Click="DialogButton_Click"
            Content="带验证输入"
            Tag="9" />
        <Button
            Click="DialogButton_Click"
            Content="输入密码"
            Tag="10" />
        <Button
            Click="DialogButton_Click"
            Content="输入多行"
            Tag="11" />
        <Button
            Click="DialogButton_Click"
            Content="输入数字"
            Tag="12" />
        <Button
            Click="DialogButton_Click"
            Content="输入整数"
            Tag="13" />
        <Button
            Click="DialogButton_Click"
            Content="单选"
            Tag="14" />
        <Button
            Click="DialogButton_Click"
            Content="多选"
            Tag="15" />
        <Button
            Click="DialogButton_Click"
            Content="自定义"
            Tag="16" />
    </WrapPanel>
</UserControl>
