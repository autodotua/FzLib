<UserControl
    x:Class="FzLib.Avalonia.Test.Views.LoadingPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FzLib.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FzLib.Avalonia.Test.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:LoadingViewModel"
    mc:Ignorable="d">
    <Panel>
        <StackPanel>
            <StackPanel.Styles>
                <Style Selector="Button">
                    <Setter Property="Margin" Value="8" />
                </Style>
                <Style Selector="ComboBox">
                    <Setter Property="Margin" Value="8" />
                </Style>
            </StackPanel.Styles>

            <Button
                Command="{Binding ShowLoading1Command}"
                Content="显示1秒"
                Tag="1" />
            <Button
                Command="{Binding ShowLoading2Command}"
                Content="延迟1秒后显示1秒"
                Tag="2" />
            <Button
                Command="{Binding ShowLoading3Command}"
                Content="延迟2秒，但提前1秒取消"
                Tag="3" />
        </StackPanel>
        <c:ProgressRingOverlay
            Delay="{Binding Delay}"
            IsActive="{Binding IsActive}" />
    </Panel>
</UserControl>
