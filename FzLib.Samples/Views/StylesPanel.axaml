<UserControl
    x:Class="FzLib.Samples.Views.StylesPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="using:FzLib.Avalonia.Behaviors"
    xmlns:c="using:FzLib.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel
            Margin="8"
            Spacing="8">
            <HeaderedContentControl
                Classes="GroupBox"
                Header="按钮">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Classes="accent"
                        Content=".accent" />
                    <Button
                        Classes="Primary"
                        Content=".Primary" />
                    <Button
                        Classes="Link"
                        Content=".Link" />
                    <Button
                        Classes="Transparent"
                        Content=".Transparent" />
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl
                Classes="GroupBox"
                Header="组合框">
                <StackPanel
                    Orientation="Vertical"
                    Spacing="8">
                    <HeaderedContentControl
                        Classes="GroupBox"
                        Header=".GroupBox">
                        <TextBlock Text="内容内容内容内容内容内容内容内容内容内容内容" />
                    </HeaderedContentControl>
                    <HeaderedContentControl
                        Classes="GroupBoxWithBorder"
                        Header=".GroupBoxWithBorder">
                        <TextBlock Text="内容内容内容内容内容内容内容内容内容内容内容" />
                    </HeaderedContentControl>
                </StackPanel>
            </HeaderedContentControl>
            <HeaderedContentControl
                Classes="GroupBox"
                Header="文本框">
                <StackPanel
                    Orientation="Vertical"
                    Spacing="8">
                    <TextBox
                        Classes="Display"
                        MaxLines="5"
                        Text=".Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display.Display"
                        TextWrapping="Wrap" />
                </StackPanel>
            </HeaderedContentControl>
        </StackPanel>
    </ScrollViewer>

</UserControl>
