<UserControl
    x:Class="FzLib.Samples.Views.JsonPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:FzLib.Avalonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:FzLib.Samples.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:JsonViewModel"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,8,*">
        <WrapPanel
            ItemSpacing="8"
            ItemWidth="120">
            <Button
                Command="{Binding TestCommand}"
                Content="测试" />
            <Button
                Command="{Binding TestFileCommand}"
                Content="测试文件" />
        </WrapPanel>
        <ScrollViewer Grid.Row="2">
            <TextBlock Text="{Binding Message}" />
        </ScrollViewer>
    </Grid>
</UserControl>
